
process borzoi_tsv_like {
  label 'gpu'
  
  input:
  path(tsv_file)
  each path(borzoi_model)
  each path(reference_genome)
  each path(targets_borzoi)
  each path(gene_annotation)
  each path(borzoi_params)
  
  output:
  tuple val("${tsv_file.simpleName}"), path('sed.h5')
  
  script:
  """
  ${params.borzoi_dir}/borzoi_sed.py \
    --stats SED,logSED,D1,D2,nD2,nDi,JS,REF,ALT \
    -f $reference_genome \
    -g $gene_annotation \
    -t $targets_borzoi \
    -o . \
    $borzoi_params \
    --ignore_allele_checks \
    $borzoi_model \
    <(awk '{print \$1,\$3,\$6,\$4,\$5}' OFS='\t' $tsv_file)
  """
  
}

process borzoi_extract_sed {
  
  input:
  tuple val(ID), path(sed_file)
  each path(targets_borzoi)
  
  output:
    path '*_predictions*'
  
  script:
    """
    ${params.borzoi_dir}/extract_sed_from_h5_gnomAD.py \
        -i ./sed.h5 \
        -t $targets_borzoi \
        -o _predictions_${ID}.tsv
    """
  
}

process borzoi_merge_folds {
  
  input:
  path predictions_by_target
  val borzoi_folds
  
  output:
    path 'merged_*.tsv'
  
  script:
    template 'merge_borzoi_folds.R'
  
}
