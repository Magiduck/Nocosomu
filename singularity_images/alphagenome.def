BootStrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%post
    # Prevent apt-get from hanging on interactive prompts (like timezone selection)
    export DEBIAN_FRONTEND=noninteractive

    apt-get -y update
    apt-get -y install software-properties-common curl git
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get -y update
    apt-get -y install python3.11 python3.11-dev python3.11-distutils

    # Set Python 3.11 as the system default
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

    # Install pip securely for Python 3.11
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3

    pip install setuptools wheel cython

    git clone https://github.com/google-deepmind/alphagenome_research.git

    pip install torch==2.2.2 --index-url https://download.pytorch.org/whl/cu121
    pip install "transformers<4.49.0"

    pip install -e ./alphagenome_research "jax[cuda12]" aiohttp requests "numpy<2.0.0" "scikit-learn<1.5.0"
    
    pip install pyfaidx tables pandas pyarrow scipy duckdb==0.6.1 openpyxl psutil pickleshare pysam biopython matplotlib einops tqdm seaborn logomaker liftover natsort "numpy<2.0.0" "scikit-learn<1.5.0"

%environment
    export LC_ALL=C

%runscript
