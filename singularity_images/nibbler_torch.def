BootStrap: docker
From: tensorflow/tensorflow:latest-gpu

%post
    pip install pandas pyarrow
    pip install scipy numpy
    pip install scikit-learn
    pip install duckdb==0.6.1
    pip install openpyxl
    pip install psutil
    pip install pickleshare
    pip install pysam
    pip install biopython
    pip install matplotlib
    pip install einops
    pip install tqdm
    pip install enformer-pytorch>=0.5
    pip install torch
    pip install seaborn
    pip install logomaker
    mkdir transformers
    python3 -c "from enformer_pytorch import Enformer; enformer = Enformer.from_pretrained('EleutherAI/enformer-official-rough', cache_dir = '/transformers')"

%environment
    export LC_ALL=C

%runscript

%labels
    Author Tijs van Lieshout
